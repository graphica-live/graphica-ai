DATABASE_URL="postgresql://user:password@localhost:5432/graphica_ai_video?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 管理者として扱う固定メールアドレス。このメールでGoogleログインすると自動的にADMIN権限が付与される。
ADMIN_EMAIL="graphicatestlive@gmail.com"

# Railway Object Storage (S3互換) の接続情報
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# Dreamina API (仕様確定後に設定)
DREAMINA_API_BASE_URL=""
DREAMINA_API_KEY=""
# 1のときはMockプロバイダを使用し、Dreamina API未接続でも動作確認できる
DREAMINA_MOCK_MODE="1"

# 管理者代理ログイン用ワンタイムトークンの有効秒数
IMPERSONATION_TOKEN_TTL_SECONDS="120"
# 代理ログインセッション自体(専用Cookie)の有効秒数
IMPERSONATION_SESSION_MAXAGE_SECONDS="3600"
# 生成ジョブのステータスポーリング間隔(ミリ秒)
GENERATION_POLL_INTERVAL_MS="10000"
