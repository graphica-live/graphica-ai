generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  ADMIN
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum CreditTxType {
  GRANT
  CONSUMPTION
  REFUND
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STAFF)
  isActive      Boolean   @default(true)
  creditBalance Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 生成フォームで選択可能な項目の制限（チェック済みのもののみ選択可）
  allowedResolutions  String[] @default(["480p"])
  // 生成できる動画長の範囲（秒）。Seedance 2.5 の duration は 4〜30 の整数で、
  // 生成フォームは1秒刻みのスライダーで選ばせるため、許可リスト（旧 allowedDurations）では
  // 最大27要素になり管理画面が破綻する。そのため下限・上限の2値で保持する。
  // DB側に 4 <= min <= max <= 30 のCHECK制約を持たせている（migration参照）。
  minDurationSeconds  Int      @default(5)
  maxDurationSeconds  Int      @default(5)
  allowedAspectRatios String[] @default(["4:3"])
  // 利用できる生成モード（reference: テキスト・参照から生成 / image: 画像から生成）。
  // 既存ユーザーは両モードを使えていたため、既定は両方許可とする。
  //
  // これは Seedance 2.5 専用の制限として扱う。MiniMax H3 のモード(image/text/firstlast/
  // reference)はここでは制御せず、allowedModels に H3 が含まれていれば全モード利用可とする。
  // 理由: 旧ブラウザの管理画面フォームはこの配列を全置換するため、H3 用の値を追記すると
  // 古いタブから保存されただけで消えてしまう。
  allowedGenerationModes String[] @default(["reference", "image"])
  // 利用できる動画生成モデル。H3 のコスト統制はこのフラグと動画長の範囲で行う。
  allowedModels          String[] @default(["seedance-2.5", "minimax-h3"])

  accounts               Account[]
  sessions               Session[]
  generationJobs         GenerationJob[]     @relation("OwnerJobs")
  actedGenerationJobs    GenerationJob[]     @relation("ActorJobs")
  creditTxAsOwner        CreditTransaction[] @relation("OwnerTx")
  creditTxAsActor        CreditTransaction[] @relation("ActorTx")
  impersonationsIssued   Impersonation[]     @relation("IssuedBy")
  impersonationsAsStaff  Impersonation[]     @relation("StaffTarget")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 非推奨。クレジット消費額はAPI使用料原価(src/lib/credits/cost.ts)から算出するようになり、
// このテーブルは課金に使われていない。デプロイのローリング中に残る旧インスタンスが
// 参照するため互換期間として残置している。
//
// 削除は2リリースに分けること。1リリースでまとめると、切替中の旧インスタンス(まだ
// /api/pricing を持つ版)がこのテーブルを参照して壊れる。
//   1. /api/pricing と参照コードだけを削除する。このモデルは残す(migrationを出さない)
//   2. そのリリースが本番に行き渡ってから、このモデルを削除して DROP TABLE を出す
// 詳細は CLAUDE.md の「DB Migration Rule（expand / contract）」を参照。
// 単価テーブル: provider(プロバイダ) x resolution x hasVideoInput -> 秒あたりクレジット(円)
model PricingRule {
  id              String   @id @default(cuid())
  provider        String   @default("dreamina")
  resolution      String
  hasVideoInput   Boolean  @default(false)
  creditPerSecond Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, resolution, hasVideoInput])
}

model GenerationJob {
  id          String @id @default(cuid())
  userId      String
  actorUserId String?

  batchId    String
  batchIndex Int    @default(0)
  batchSize  Int    @default(1)

  status JobStatus @default(PENDING)
  // どのプロバイダのタスクかを表す不変値。ポーラーはこの値でジョブを振り分ける。
  // ローリングデプロイ中、自分が知らないproviderのジョブを誤って別APIへ問い合わせないよう、
  // ポーリング対象を provider で絞る根拠になる（src/lib/jobs/poller.ts）。
  provider      String  @default("dreamina")
  // どのモデルで生成したか。課金式・履歴表示・「引用」時のフォーム復元に使う。
  model         String  @default("seedance-2.5")
  providerJobId String?
  providerError String? @db.Text
  // プロバイダが返したエラーコード（開発者向け。ユーザーには providerError の文言を出す）
  providerErrorCode String?

  // 生成モード。DB default を置かない理由は src/lib/generation/generation-mode.ts を参照
  // （ローリング中の旧コードが作る image ジョブが 'reference' と誤記録されるのを防ぐ）。
  generationMode     String?
  prompt             String   @db.Text
  referenceImageKeys String[]
  referenceVideoKeys String[] @default([])
  referenceAudioKeys String[] @default([])
  firstFrameImageKey String?
  endFrameImageKey   String?
  resolution         String
  durationSeconds    Int
  aspectRatio        String
  generateAudio      Boolean  @default(true)

  creditCost Int

  // プロバイダが完了時に報告した実トークン消費量(usage.total_tokens)。
  // Seedance 2.5 のトークン課金でのみ使う。未報告の場合はnull。
  actualTotalTokens Int?
  // プロバイダが報告した使用量を正規化して保存したもの（ProviderUsage）。
  // モデルごとに課金単位が違う（Seedanceはトークン、H3は秒＋入力画像枚数）ため、
  // 実績の生データはこちらに残す。
  providerUsage Json?

  videoObjectKey     String?
  thumbnailObjectKey String?

  // お気に入り(ピン止め)。並び順は「全ての生成履歴」と揃えてcreatedAt順にするため、
  // ピン時刻ではなくフラグで持つ(cursorページングのソートキーを不変に保つ)。
  isPinned Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  owner    User                @relation("OwnerJobs", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?               @relation("ActorJobs", fields: [actorUserId], references: [id])
  creditTx CreditTransaction[]

  @@index([userId, createdAt])
  @@index([userId, isPinned, createdAt])
  @@index([status])
  @@index([batchId])
}

model CreditTransaction {
  id           String       @id @default(cuid())
  type         CreditTxType
  amount       Int
  balanceAfter Int
  note         String?

  userId          String
  actorUserId     String?
  generationJobId String?

  createdAt DateTime @default(now())

  owner         User           @relation("OwnerTx", fields: [userId], references: [id], onDelete: Cascade)
  actor         User?          @relation("ActorTx", fields: [actorUserId], references: [id])
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id])

  @@index([userId, type, createdAt])
}

// なりすまし代理ログイン用ワンタイムトークン
model Impersonation {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  staffUserId    String
  issuedByUserId String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  staff    User @relation("StaffTarget", fields: [staffUserId], references: [id], onDelete: Cascade)
  issuedBy User @relation("IssuedBy", fields: [issuedByUserId], references: [id])

  @@index([staffUserId])
}
